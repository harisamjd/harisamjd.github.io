---
// @ts-check
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Haris A. Majid — Personal Product Website",
  description = "Business Analyst, Digital Transformation Specialist, and R&D Process Development Engineer. Transforming business challenges into practical digital solutions with measurable impact."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- SEO Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://harisamajid.com" />
    
    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Haris Abdul Majid",
        "jobTitle": "Business Analyst, Digital Transformation Specialist, R&D Process Development Engineer",
        "url": "https://harisamajid.com",
        "sameAs": [
          "https://www.linkedin.com/in/harisam",
          "https://wa.me/628567890858"
        ],
        "knowsAbout": [
          "Business Analysis",
          "Digital Transformation",
          "Dashboard Development",
          "Power Platform",
          "R&D Dairy Process Development",
          "Continuous Improvement"
        ]
      }
    </script>
  </head>
  <body class="bg-bg text-text-primary selection:bg-accent selection:text-white min-h-screen flex flex-col overflow-x-hidden">
    
    <!-- Premium Intro Transition Loader Curtain Overlay -->
    <div
      id="intro-loader"
      class="fixed inset-0 z-[9999] bg-bg flex items-center justify-center pointer-events-auto"
    >
      <div
        id="loader-text"
        class="text-heading-xl md:text-display-md text-text-primary font-bold text-center opacity-0 translate-y-6 tracking-tight px-6 select-none"
      >
        Hi, I'm Haris Abdul Majid
      </div>
    </div>

    <slot name="header" />
    
    <main class="flex-grow">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Long Laboratory Liquid Column (Thematic R&D scroll progress cylinder, aligned perfectly with the card) -->
    <div
      id="scroll-liquid-column"
      class="fixed right-[30px] top-24 bottom-24 w-3.5 rounded-full border border-divider/60 bg-card-bg/80 z-30 overflow-hidden shadow-inner pointer-events-none hidden md:block opacity-0 transition-opacity duration-500"
    >
      <!-- Liquid Level Fill (Fills top-to-bottom as progress increases) -->
      <div
        id="scroll-liquid-fill"
        class="absolute top-0 left-0 right-0 w-full bg-gradient-to-b from-accent to-blue-400 rounded-b-full transition-all duration-100 ease-out"
        style="height: 0%;"
      ></div>
      <!-- Tiny fluid bubble markers inside the column for aesthetic -->
      <div class="absolute inset-0 flex flex-col justify-around items-center opacity-30">
        <span class="w-0.5 h-0.5 bg-white rounded-full"></span>
        <span class="w-1.5 h-[1px] bg-white"></span>
        <span class="w-0.5 h-0.5 bg-white rounded-full"></span>
        <span class="w-1.5 h-[1px] bg-white"></span>
        <span class="w-0.5 h-0.5 bg-white rounded-full"></span>
        <span class="w-1.5 h-[1px] bg-white"></span>
        <span class="w-0.5 h-0.5 bg-white rounded-full"></span>
      </div>
    </div>

    <!-- Floating Circular Scroll Progress Indicator (Moves dynamically along the column) -->
    <div
      id="scroll-progress-container"
      class="fixed right-[13px] top-0 z-40 hidden md:flex flex-col items-center select-none pointer-events-none opacity-0 transition-opacity duration-500 cursor-pointer"
      role="button"
      aria-label="Scroll to top"
    >
      <div class="relative w-12 h-12 flex items-center justify-center bg-bg/85 backdrop-blur-md rounded-full border border-divider shadow-lg hover:border-accent/40 transition-colors">
        <!-- SVG Progress Circle -->
        <svg class="absolute inset-0 w-full h-full -rotate-90">
          <circle
            cx="24"
            cy="24"
            r="20"
            class="stroke-divider/30 fill-none"
            stroke-width="2"
          />
          <circle
            id="scroll-progress-circle"
            cx="24"
            cy="24"
            r="20"
            class="stroke-accent fill-none"
            stroke-width="2"
            stroke-dasharray="125.66"
            stroke-dashoffset="125.66"
            stroke-linecap="round"
            style="transition: stroke-dashoffset 0.1s ease-out;"
          />
        </svg>
        <span id="scroll-progress-text" class="text-[10px] font-mono font-semibold text-text-primary">
          0%
        </span>
      </div>
    </div>

    <!-- Intro and Smooth Scroll Scripting -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Check if user prefers reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Handle Intro Loader
      window.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('intro-loader');
        const loaderText = document.getElementById('loader-text');
        
        if (!loader || !loaderText) return;

        if (prefersReducedMotion) {
          loader.remove();
          window.dispatchEvent(new CustomEvent('intro-complete'));
          return;
        }

        const tl = gsap.timeline({
          onComplete: () => {
            loader.remove(); // Remove loader overlay entirely from DOM to prevent click blocking
            window.dispatchEvent(new CustomEvent('intro-complete'));
          }
        });

        // 1. Fade in and slide up welcome name text
        tl.to(loaderText, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
        })
        // 2. Short pause for reading comfort
        .to(loaderText, {
          duration: 0.8,
        })
        // 3. Fade out welcome text
        .to(loaderText, {
          opacity: 0,
          y: -20,
          duration: 0.4,
          ease: 'power3.in',
        })
        // 4. Zoom out and fade out loader curtain to reveal main webpage
        .to(loader, {
          scale: 1.15,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.inOut',
        });
      });

      // Handle Lenis scroll
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.0,
          smoothWheel: true,
          syncTouch: false,
        });

        // Synchronize Lenis scroll updates with GSAP ScrollTrigger
        lenis.on('scroll', ScrollTrigger.update);

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
        (window as any).lenis = lenis;
      }

      // Scroll Progress Calculation and scroll-to-top handler
      window.addEventListener('DOMContentLoaded', () => {
        const progressCircle = document.getElementById('scroll-progress-circle');
        const progressText = document.getElementById('scroll-progress-text');
        const progressContainer = document.getElementById('scroll-progress-container');
        const liquidFill = document.getElementById('scroll-liquid-fill');
        
        if (!progressCircle || !progressText || !progressContainer) return;

        const circumference = 125.66; // 2 * Math.PI * 20

        const updateScrollProgress = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;

          // Update text percentage
          progressText.textContent = Math.round(scrollPercent) + '%';

          // Update stroke dashoffset
          const offset = circumference - (scrollPercent / 100) * circumference;
          progressCircle.setAttribute('stroke-dashoffset', offset.toString());

          // Update liquid tube fill height (flowing top-to-bottom)
          if (liquidFill) {
            liquidFill.style.height = scrollPercent + '%';
          }

          // Calculate dynamic vertical position for the card (floating at the bottom tip of the liquid)
          const topOffset = 96; // matches top-24 (96px)
          const bottomOffset = 96; // matches bottom-24 (96px)
          const cardHeight = 48; // matches w-12 h-12 (48px)
          const availableHeight = window.innerHeight - topOffset - bottomOffset - cardHeight;
          const cardTop = topOffset + (scrollPercent / 100) * availableHeight;

          progressContainer.style.transform = `translate3d(0, ${cardTop}px, 0)`;

          // Show indicator only after scrolling down slightly (e.g. 100px)
          const liquidColumn = document.getElementById('scroll-liquid-column');
          if (scrollTop > 100) {
            progressContainer.classList.remove('opacity-0', 'pointer-events-none');
            progressContainer.classList.add('opacity-100');
            
            if (liquidColumn) {
              liquidColumn.classList.remove('opacity-0', 'pointer-events-none');
              liquidColumn.classList.add('opacity-100');
            }
          } else {
            progressContainer.classList.remove('opacity-100');
            progressContainer.classList.add('opacity-0', 'pointer-events-none');
            
            if (liquidColumn) {
              liquidColumn.classList.remove('opacity-100');
              liquidColumn.classList.add('opacity-0', 'pointer-events-none');
            }
          }
        };

        if ((window as any).lenis) {
          (window as any).lenis.on('scroll', updateScrollProgress);
        } else {
          window.addEventListener('scroll', updateScrollProgress);
        }
        updateScrollProgress(); // Initial run

        // Click to scroll to top
        progressContainer.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      });
    </script>
  </body>
</html>
