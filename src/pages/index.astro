---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { FileDown, X } from '@lucide/astro';

// Section components
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import TimelineSection from '../components/sections/TimelineSection.astro';
import ExpertiseSection from '../components/sections/ExpertiseSection.astro';
import ImpactSection from '../components/sections/ImpactSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import CertificatesSection from '../components/sections/CertificatesSection.astro';
import DownloadCV from '../components/sections/DownloadCV.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<MainLayout>
  <!-- Navbar inside header slot -->
  <Navbar slot="header" />

  <!-- Base landing sections structure -->
  <div class="pt-[72px]" id="presentation-wrapper">
    <!-- Real Sections (Phase 2 - 5) -->
    <HeroSection />
    
    <AboutSection />
    
    <TimelineSection />

    <ExpertiseSection />

    <ImpactSection />

    <ProjectsSection />

    <CertificatesSection />

    <DownloadCV />

    <ContactSection />
  </div>

  <!-- Interactive CV Choice Selection Popup Modal Overlay (Rendered at root layout level for perfect fixed position viewport centering) -->
  <div
    id="cv-popup-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6 hidden"
    role="dialog"
    aria-modal="true"
  >
    <!-- Dark blurred backdrop -->
    <div id="cv-modal-backdrop" class="absolute inset-0 bg-bg/90 backdrop-blur-md opacity-0"></div>

    <!-- Choice dialog box -->
    <div
      id="cv-modal-box"
      class="relative w-full max-w-[480px] bg-card-bg border border-divider rounded-lg shadow-2xl p-6 md:p-8 z-10 transform scale-90 opacity-0 flex flex-col gap-6"
    >
      <!-- Close Button icon -->
      <button
        id="cv-modal-close"
        class="absolute top-4 right-4 p-2 text-text-secondary hover:text-text-primary rounded-full hover:bg-surface transition-colors cursor-pointer"
        aria-label="Close CV Selector"
      >
        <X class="w-4.5 h-4.5" />
      </button>

      <!-- Heading -->
      <div class="text-center">
        <span class="text-caption text-accent uppercase font-bold tracking-widest font-mono block mb-1">
          Select Version
        </span>
        <h3 class="text-heading-md font-bold text-text-primary mb-2">
          Choose CV Focus
        </h3>
        <p class="text-body-sm text-text-secondary leading-relaxed">
          Please select the CV version that aligns with the role or opportunity you are offering:
        </p>
      </div>

      <!-- Action Buttons selection list -->
      <div class="flex flex-col gap-3">
        <!-- Business Analyst option -->
        <a
          href="/docs/CV-Haris A Majid_BA-20260716.pdf"
          download
          class="w-full flex items-center justify-center gap-2.5 text-body-sm bg-accent text-white px-5 py-3.5 rounded-md hover:bg-blue-700 transition-colors font-semibold text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent cursor-pointer"
          id="cv-download-ba-btn"
        >
          <FileDown class="w-4 h-4" />
          <span>Business Analyst Focus</span>
        </a>

        <!-- R&D Process option -->
        <a
          href="/docs/CV-Haris A Majid_RnD-20260716.pdf"
          download
          class="w-full flex items-center justify-center gap-2.5 text-body-sm bg-surface border border-divider text-text-primary px-5 py-3.5 rounded-md hover:bg-divider transition-colors font-semibold text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-divider cursor-pointer"
          id="cv-download-rd-btn"
        >
          <FileDown class="w-4 h-4" />
          <span>R&D Process Focus</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Presentation Mode Dock Controls -->
  <div
    id="presentation-dock"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-card-bg/90 backdrop-blur-md border border-divider px-6 py-3 rounded-full hidden items-center gap-5 shadow-2xl z-50 transition-all duration-300"
  >
    <div class="flex items-center gap-2">
      <button
        id="pres-prev-btn"
        class="p-2 bg-surface hover:bg-divider border border-divider text-text-primary rounded-full transition-colors cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
        aria-label="Previous Slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      
      <span id="pres-slide-indicator" class="text-caption font-bold font-mono text-text-primary min-w-[60px] text-center select-none">
        1 / 9
      </span>

      <button
        id="pres-next-btn"
        class="p-2 bg-surface hover:bg-divider border border-divider text-text-primary rounded-full transition-colors cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
        aria-label="Next Slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
    
    <div class="h-4 w-[1px] bg-divider"></div>
    
    <button
      id="pres-exit-btn"
      class="text-[11px] uppercase tracking-wider bg-surface hover:bg-divider hover:text-text-primary text-text-secondary border border-divider px-4 py-2 rounded-full transition-colors font-bold cursor-pointer"
    >
      Exit Slide View
    </button>
  </div>

  <style is:global>
    /* Presentation (Slide) Mode overrides */
    html.presentation-active,
    html.presentation-active body {
      overflow: hidden !important;
      height: 100vh !important;
      width: 100vw !important;
      scroll-behavior: auto !important;
    }

    html.presentation-active #presentation-wrapper {
      display: flex !important;
      flex-direction: column !important;
      height: 100vh !important;
      width: 100vw !important;
      padding-top: 0 !important;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    html.presentation-active #presentation-wrapper > section {
      height: 100vh !important;
      width: 100vw !important;
      flex-shrink: 0 !important;
      overflow-y: auto !important;
      padding-top: 60px !important;
      padding-bottom: 90px !important;
      box-sizing: border-box !important;
      opacity: 1 !important;
      transform: none !important;
    }

    /* Hide scrollbars in slide mode for sections to make presentation immersive */
    html.presentation-active #presentation-wrapper > section::-webkit-scrollbar {
      display: none;
    }
    html.presentation-active #presentation-wrapper > section {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Hide smooth-scroll progress utilities in slide mode */
    html.presentation-active #scroll-liquid-column,
    html.presentation-active #scroll-progress-container {
      display: none !important;
    }

    /* Hide main navigation header to make slide fullscreen */
    html.presentation-active #main-header {
      transform: translateY(-100%) !important;
      pointer-events: none !important;
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('presentation-toggle');
      const dock = document.getElementById('presentation-dock');
      const prevBtn = document.getElementById('pres-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('pres-next-btn') as HTMLButtonElement | null;
      const exitBtn = document.getElementById('pres-exit-btn');
      const indicator = document.getElementById('pres-slide-indicator');
      const wrapper = document.getElementById('presentation-wrapper');
      
      if (!wrapper) return;
      const sections = wrapper.querySelectorAll('section');
      if (sections.length === 0) return;

      let currentSlide = 0;
      let isScrolling = false;

      const updateSlideState = () => {
        if (!wrapper || !indicator || !prevBtn || !nextBtn) return;
        
        // Translate the wrapper
        wrapper.style.transform = `translateY(-${currentSlide * 100}vh)`;
        
        // Update indicator
        indicator.textContent = `${currentSlide + 1} / ${sections.length}`;
        
        // Update button states
        prevBtn.disabled = currentSlide === 0;
        nextBtn.disabled = currentSlide === sections.length - 1;
      };

      const startPresentation = () => {
        document.documentElement.classList.add('presentation-active');
        if (dock) {
          dock.classList.remove('hidden');
          dock.classList.add('flex');
        }
        currentSlide = 0;
        updateSlideState();
      };

      const stopPresentation = () => {
        document.documentElement.classList.remove('presentation-active');
        if (dock) {
          dock.classList.add('hidden');
          dock.classList.remove('flex');
        }
        if (wrapper) {
          wrapper.style.transform = '';
        }
        // Scroll back to the active section naturally
        if (sections[currentSlide]) {
          sections[currentSlide].scrollIntoView({ behavior: 'auto' });
        }
      };

      const goToSlide = (index: number) => {
        if (index < 0 || index >= sections.length) return;
        currentSlide = index;
        updateSlideState();
      };

      // Event listeners
      toggleBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        startPresentation();
      });

      exitBtn?.addEventListener('click', stopPresentation);
      
      prevBtn?.addEventListener('click', () => {
        goToSlide(currentSlide - 1);
      });

      nextBtn?.addEventListener('click', () => {
        goToSlide(currentSlide + 1);
      });

      // Keyboard support
      document.addEventListener('keydown', (e) => {
        if (!document.documentElement.classList.contains('presentation-active')) return;
        
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          goToSlide(currentSlide + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlide(currentSlide - 1);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          stopPresentation();
        }
      });

      // Mouse wheel support (with debounce)
      window.addEventListener('wheel', (e) => {
        if (!document.documentElement.classList.contains('presentation-active')) return;
        e.preventDefault();
        if (isScrolling) return;

        isScrolling = true;
        if (e.deltaY > 0) {
          goToSlide(currentSlide + 1);
        } else {
          goToSlide(currentSlide - 1);
        }

        setTimeout(() => {
          isScrolling = false;
        }, 700); // Debounce duration matching CSS transition
      }, { passive: false });
    });
  </script>

  <Footer slot="footer" />
</MainLayout>
