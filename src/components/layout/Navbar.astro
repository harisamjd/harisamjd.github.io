---
import { Menu, X } from '@lucide/astro';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Journey', href: '#journey' },
  { label: 'Expertise', href: '#expertise' },
  { label: 'Impact', href: '#impact' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 w-full h-[72px] z-50 transition-all duration-300 border-b border-transparent bg-transparent"
>
  <div class="max-w-[1100px] h-full mx-auto px-6 flex items-center justify-between">
    <!-- Brand / Name -->
    <a href="#" class="text-body-lg font-semibold tracking-tight hover:opacity-80 transition-opacity" aria-label="Haris Abdul Majid - Home">
      Haris A. Majid
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link text-body-sm text-text-secondary hover:text-text-primary transition-colors py-2 relative"
        >
          {item.label}
        </a>
      ))}
      <a
        href="#download-cv"
        class="text-body-sm bg-accent text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors font-medium cursor-pointer"
        id="nav-cv-trigger"
      >
        Download CV
      </a>
    </nav>
 
    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      class="p-2 md:hidden text-text-primary hover:text-text-secondary transition-colors"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle Menu"
    >
      <Menu class="w-6 h-6 show-menu-icon" />
      <X class="w-6 h-6 hide-menu-icon hidden" />
    </button>
  </div>
 
  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 right-0 w-full sm:w-[320px] bg-card-bg border-l border-divider z-40 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col pt-24 px-6 gap-6 shadow-lg"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link text-heading-sm text-text-secondary hover:text-text-primary transition-colors py-2 border-b border-divider"
      >
        {item.label}
      </a>
    ))}
    <a
      href="#download-cv"
      class="text-body bg-accent text-white px-4 py-3 rounded-md hover:bg-blue-700 transition-colors font-medium text-center mt-4 cursor-pointer"
      id="mobile-nav-cv-trigger"
    >
      Download CV
    </a>
  </div>
</header>
 
<script>
  const header = document.getElementById('main-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const showIcon = toggleBtn?.querySelector('.show-menu-icon');
  const hideIcon = toggleBtn?.querySelector('.hide-menu-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const mobileNavCvTrigger = document.getElementById('mobile-nav-cv-trigger');
 
  // 1. Scroll State Behavior
  function updateScrollState() {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.remove('bg-transparent', 'border-transparent');
      header.classList.add('bg-bg/80', 'backdrop-blur-md', 'border-divider', 'shadow-sm');
    } else {
      header.classList.remove('bg-bg/80', 'backdrop-blur-md', 'border-divider', 'shadow-sm');
      header.classList.add('bg-transparent', 'border-transparent');
    }
  }
 
  window.addEventListener('scroll', updateScrollState);
  updateScrollState(); // Initialize state
 
  // 2. Mobile Menu Toggle
  function toggleMobileMenu() {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    toggleBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('translate-x-full');
    showIcon?.classList.toggle('hidden');
    hideIcon?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden');
  }
 
  toggleBtn?.addEventListener('click', toggleMobileMenu);
 
  // Close mobile menu when clicking a link
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('translate-x-full')) {
        toggleMobileMenu();
      }
    });
  });

  // Close mobile drawer when clicking CV trigger
  mobileNavCvTrigger?.addEventListener('click', () => {
    if (!mobileMenu?.classList.contains('translate-x-full')) {
      toggleMobileMenu();
    }
  });

  // 3. Scroll Spy (Highlight active section)
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  function scrollSpy() {
    let currentSectionId = '';
    const scrollPosition = window.scrollY + 100; // offset

    sections.forEach((section) => {
      const sectionTop = (section as HTMLElement).offsetTop;
      const sectionHeight = section.clientHeight;
      if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
        currentSectionId = section.getAttribute('id') || '';
      }
    });

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href === `#${currentSectionId}`) {
        link.classList.remove('text-text-secondary');
        link.classList.add('text-accent', 'font-medium');
      } else {
        link.classList.remove('text-accent', 'font-medium');
        link.classList.add('text-text-secondary');
      }
    });
  }

  window.addEventListener('scroll', scrollSpy);
  scrollSpy(); // Initialize spy
</script>
