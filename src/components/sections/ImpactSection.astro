---
---

<section
  id="impact"
  class="py-[120px] bg-bg px-6 transition-opacity opacity-0 transform translate-y-[40px]"
  aria-labelledby="impact-heading"
>
  <div class="max-w-[1100px] mx-auto">
    <!-- Header -->
    <div class="mb-16">
      <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
        Outcomes
      </span>
      <h2 id="impact-heading" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4">
        Professional Impact & Accomplishments
      </h2>
      <p class="text-body text-text-secondary max-w-[640px]">
        A record of driving improvements across industrial operations, enterprise software deployment, and independent technical projects.
      </p>
    </div>

    <!-- Grid of Outcomes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: Manufacturing Impact -->
      <div class="bg-card-bg border border-divider p-8 rounded-lg flex flex-col gap-6 hover:border-accent/25 hover:shadow-md transition-all duration-300">
        <div class="flex items-center gap-3 border-b border-divider pb-4 shrink-0">
          <span class="text-2xl select-none">🏭</span>
          <div>
            <h3 class="text-body-sm font-bold text-text-primary">Manufacturing Impact</h3>
            <span class="text-[9px] font-mono text-accent font-semibold tracking-wider uppercase block">Operations & Scale-Up</span>
          </div>
        </div>
        <ul class="flex flex-col gap-4 flex-grow">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              End-to-end product scale-up from laboratory trials to commercial scale production.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Cross-functional coordination during first-time commercial production runs.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Business case formulation and Cost of Goods Manufactured (COGM) analysis for new product developments.
            </span>
          </li>
        </ul>
      </div>

      <!-- Card 2: Digital Transformation Impact -->
      <div class="bg-card-bg border border-divider p-8 rounded-lg flex flex-col gap-6 hover:border-accent/25 hover:shadow-md transition-all duration-300">
        <div class="flex items-center gap-3 border-b border-divider pb-4 shrink-0">
          <span class="text-2xl select-none">💻</span>
          <div>
            <h3 class="text-body-sm font-bold text-text-primary">Digital Transformation</h3>
            <span class="text-[9px] font-mono text-accent font-semibold tracking-wider uppercase block">Systems & Automation</span>
          </div>
        </div>
        <ul class="flex flex-col gap-4 flex-grow">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Developed and deployed 2 enterprise workflow applications.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Designed custom business intelligence dashboards for data-driven decision making.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Built automated workflow pipelines to eliminate repetitive manual tasks.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Implemented electronic approval systems to accelerate task execution times.
            </span>
          </li>
        </ul>
      </div>

      <!-- Card 3: Personal Innovation -->
      <div class="bg-card-bg border border-divider p-8 rounded-lg flex flex-col gap-6 hover:border-accent/25 hover:shadow-md transition-all duration-300">
        <div class="flex items-center gap-3 border-b border-divider pb-4 shrink-0">
          <span class="text-2xl select-none">🚀</span>
          <div>
            <h3 class="text-body-sm font-bold text-text-primary">Personal Innovation</h3>
            <span class="text-[9px] font-mono text-accent font-semibold tracking-wider uppercase block">Independent Projects</span>
          </div>
        </div>
        <ul class="flex flex-col gap-4 flex-grow">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Created and maintained 4 custom web applications for small businesses.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Developed a custom stock analysis and portfolio modeling platform.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Built a personal cash flow monitoring and financial visualization tool.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0 mt-1.5"></span>
            <span class="text-body-sm text-text-secondary leading-relaxed">
              Set up and configured a localized neighborhood internet network infrastructure.
            </span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('impact');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(section, { opacity: 1, y: 0 });
    } else {
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          toggleActions: 'play none none none',
        }
      });
    }
  });
</script>
