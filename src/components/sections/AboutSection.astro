---
import { personalInfo } from '../../content/data/personal';
import { Image } from 'astro:assets';
// Import profile image
import profilePhoto from '../../assets/picts/FAZZA-3410.jpg';
---

<section
  id="about"
  class="py-[120px] bg-surface bg-grid-mesh/30 border-y border-divider px-6 transition-opacity opacity-0 transform translate-y-[40px] entry-section"
  aria-labelledby="about-heading"
>
  <div class="max-w-[1100px] mx-auto">
    <!-- Header rhythm -->
    <div class="mb-12">
      <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
        About Me
      </span>
      <h2 id="about-heading" class="text-heading-xl text-text-primary font-bold tracking-tight">
        Engineering Better Processes
      </h2>
    </div>

    <!-- Core Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Profile Photo Column (span 3) -->
      <div class="lg:col-span-3 flex flex-col items-center">
        <div class="relative w-full aspect-square md:aspect-[3/4] rounded-lg overflow-hidden border border-divider shadow-md group">
          <Image
            src={profilePhoto}
            alt="Haris Abdul Majid Profile"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            width={600}
            height={800}
            quality={85}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-bg/40 to-transparent opacity-60 pointer-events-none"></div>
        </div>
      </div>

      <!-- Story Bio Column (span 5) -->
      <div class="lg:col-span-5 flex flex-col gap-6 text-body text-text-secondary leading-relaxed">
        {personalInfo.summary.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        
        <!-- Philosophy callout -->
        <blockquote class="border-l-2 border-accent pl-4 py-1 mt-4 italic text-text-primary bg-card-bg/40 rounded-r-md">
          "{personalInfo.philosophy}"
        </blockquote>
      </div>

      <!-- Principles Column (span 4) -->
      <div class="lg:col-span-4 flex flex-col gap-8">
        <div>
          <h3 class="text-heading-sm font-bold text-text-primary mb-2">
            Core Principles
          </h3>
          
          <div class="flex flex-col gap-3">
            {personalInfo.principles.map((principle) => (
              <div class="p-4 bg-card-bg border border-divider rounded-md hover:shadow-sm hover:border-text-secondary/20 transition-all duration-300">
                <h4 class="text-body font-semibold text-text-primary mb-1">
                  {principle.title}
                </h4>
                <p class="text-body-sm text-text-secondary">
                  {principle.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const entrySections = document.querySelectorAll('.entry-section');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    entrySections.forEach((section) => {
      if (prefersReducedMotion) {
        gsap.set(section, { opacity: 1, y: 0 });
      } else {
        gsap.to(section, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 80%',
            toggleActions: 'play none none none',
          }
        });
      }
    });
  });
</script>
