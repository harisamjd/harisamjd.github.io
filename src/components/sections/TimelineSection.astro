---
import { careerTimeline } from '../../content/data/personal';
import { Calendar } from '@lucide/astro';
---

<section
  id="journey"
  class="py-[120px] lg:py-0 lg:h-[calc(100vh-72px)] bg-bg px-6 overflow-hidden transition-opacity opacity-0 transform translate-y-[40px] entry-section flex flex-col justify-center"
  aria-labelledby="journey-heading-desktop"
>
  <div class="max-w-[1100px] mx-auto relative lg:hidden w-full">
    <!-- Mobile Header -->
    <div class="mb-16">
      <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
        My Evolution
      </span>
      <h2 id="journey-heading-mobile" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4">
        From Manufacturing to Digital Transformation
      </h2>
      <p class="text-body text-text-secondary max-w-[640px]">
        Every stage of my career has taught me a different way to solve problems. Instead of changing industries, I have continuously expanded the way I create value.
      </p>
    </div>

    <!-- Mobile Vertical Timeline -->
    <div class="relative flex flex-col pl-8 gap-12">
      <!-- Progress Track Line -->
      <div class="absolute left-[11px] top-2 bottom-2 w-[2px] bg-divider"></div>
      <!-- Animated Progress Fill Line -->
      <div
        id="timeline-progress-vertical"
        class="absolute left-[11px] top-2 w-[2px] bg-accent origin-top scale-y-0"
      ></div>

      {careerTimeline.map((item, index) => {
        const isLast = index === careerTimeline.length - 1;
        if (item.branches) {
          return (
            <div class="relative timeline-node-mobile flex flex-col gap-2">
              <!-- Bullet Point Indicator -->
              <div class="absolute -left-[27px] top-1.5 w-4 h-4 rounded-full border-2 border-accent bg-white scale-125 timeline-bullet z-10">
                <div class="w-1.5 h-1.5 bg-accent rounded-full m-auto mt-[3px]"></div>
              </div>

              <!-- Content Card -->
              <div class="flex items-center gap-2 text-caption text-text-muted font-medium mb-1">
                <Calendar class="w-3.5 h-3.5" />
                <span>{item.period}</span>
              </div>
              
              <!-- Branched Sub-Cards -->
              <div class="flex flex-col gap-4 border-l-2 border-dashed border-accent/20 pl-4 py-2 mt-1">
                {item.branches.map((branch) => (
                  <div class="bg-surface/60 border border-divider p-4 rounded-lg relative hover:border-accent/35 transition-all">
                    <span class="inline-block text-[9px] tracking-wider font-bold uppercase px-2 py-0.5 bg-accent/10 border border-accent/20 text-accent rounded mb-2">
                      {branch.badge}
                    </span>
                    <h4 class="text-body-sm font-semibold text-text-primary">
                      {branch.role}
                    </h4>
                    <span class="text-caption font-medium text-text-secondary block mt-0.5">
                      {branch.company}
                    </span>
                    <p class="text-caption text-text-muted mt-2 leading-relaxed">
                      {branch.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          );
        }

        return (
          <div class="relative timeline-node-mobile flex flex-col gap-2">
            <!-- Bullet Point Indicator -->
            <div class={`absolute -left-[27px] top-1.5 w-4 h-4 rounded-full border-2 bg-white transition-all duration-500 timeline-bullet ${isLast ? 'border-accent scale-125' : 'border-divider'}`}>
              {isLast && <div class="w-1.5 h-1.5 bg-accent rounded-full m-auto mt-[3px]"></div>}
            </div>

            <!-- Content Card -->
            <div class="flex items-center gap-2 text-caption text-text-muted font-medium">
              <Calendar class="w-3.5 h-3.5" />
              <span>{item.period}</span>
            </div>
            <h3 class={`text-heading-sm font-semibold ${isLast ? 'text-accent' : 'text-text-primary'}`}>
              {item.role}
            </h3>
            <span class="text-body-sm font-medium text-text-secondary">
              {item.company}
            </span>
            <p class="text-body-sm text-text-muted mt-1 max-w-[480px]">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Desktop Pinned Horizontal Timeline (hidden on <lg) -->
  <div class="hidden lg:block w-full overflow-hidden" id="timeline-horizontal-container">
    <!-- Scroll Track Container -->
    <div class="relative w-full flex items-center h-[540px] select-none">
      <div 
        id="timeline-scroll-track" 
        class="flex gap-16 items-center h-full"
        style="width: max-content; padding-left: calc(50vw - 220px); padding-right: calc(50vw - 340px);"
      >
        <!-- Slide 0: Intro Card -->
        <div class="flex-shrink-0 w-[440px] flex flex-col justify-center pr-12">
          <span class="text-caption text-accent font-bold tracking-widest uppercase block mb-3 font-mono">
            My Evolution
          </span>
          <h2 id="journey-heading-desktop" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4 leading-tight">
            From Manufacturing to Digital
          </h2>
          <p class="text-body text-text-secondary leading-relaxed mb-6">
            Every stage of my career has taught me a different way to solve problems. Instead of changing industries, I have continuously expanded the way I create value.
          </p>
          <div class="flex items-center gap-2.5 text-xs text-text-muted font-bold tracking-wider uppercase">
            <span>Scroll vertically to step through</span>
            <span class="animate-bounce">→</span>
          </div>
        </div>

        {careerTimeline.map((item, index) => {
          const isLast = index === careerTimeline.length - 1;
          const stepNum = String(index + 1).padStart(2, '0');
          
          if (item.branches) {
            return (
              <div class="flex-shrink-0 w-[680px] bg-card-bg border border-divider p-8 rounded-2xl shadow-xl relative flex flex-col justify-between h-[420px] hover:border-accent/25 transition-all duration-300">
                <div>
                  <div class="flex justify-between items-center border-b border-divider pb-3 mb-4">
                    <span class="text-caption text-accent font-bold tracking-widest font-mono uppercase">
                      {item.period}
                    </span>
                    <span class="text-caption text-text-muted font-bold font-mono">
                      Step {stepNum} / 05
                    </span>
                  </div>
                  
                  <div class="grid grid-cols-2 gap-4">
                    {item.branches.map((branch) => (
                      <div class="bg-surface/50 border border-divider hover:border-accent/20 p-4 rounded-xl flex flex-col justify-between min-h-[240px] transition-all">
                        <div>
                          <span class="inline-block text-[9px] tracking-wider font-bold uppercase px-2 py-0.5 bg-accent/10 border border-accent/20 text-accent rounded mb-2">
                            {branch.badge}
                          </span>
                          <h4 class="text-caption font-semibold leading-tight text-text-primary">
                            {branch.role}
                          </h4>
                          <span class="text-[11px] font-medium text-text-secondary block mt-0.5">
                            {branch.company}
                          </span>
                        </div>
                        <p class="text-[11px] text-text-muted mt-3 leading-relaxed">
                          {branch.description}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <div class="flex-shrink-0 w-[380px] bg-card-bg border border-divider p-8 rounded-2xl shadow-xl relative flex flex-col justify-between h-[420px] hover:border-accent/25 transition-all duration-300">
              <div>
                <div class="flex justify-between items-center border-b border-divider pb-3 mb-4">
                  <span class="text-caption text-text-secondary font-bold tracking-widest font-mono uppercase">
                    {item.period}
                  </span>
                  <span class="text-caption text-text-muted font-bold font-mono">
                    Step {stepNum} / 05
                  </span>
                </div>
                
                <h3 class="text-heading-md font-bold text-text-primary leading-snug">
                  {item.role}
                </h3>
                <span class="text-body-sm font-semibold text-accent block mt-1">
                  {item.company}
                </span>
                
                <p class="text-body-sm text-text-secondary mt-6 leading-relaxed">
                  {item.description}
                </p>
              </div>
              
              <div class="flex items-center gap-2 mt-4 text-[10px] text-text-muted font-bold tracking-wider uppercase">
                <span>Scroll to step through</span>
                <span class="animate-pulse">→</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('journey');
    const track = document.getElementById('timeline-scroll-track');
    const verticalProgress = document.getElementById('timeline-progress-vertical');

    if (!section) return;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(section, { opacity: 1, y: 0 });
      if (verticalProgress) gsap.set(verticalProgress, { scaleY: 1 });
    } else {
      // 1. Entrance Reveal for Section (Both mobile and desktop)
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      });

      // 2. Animate Mobile Vertical Timeline Progress Line
      if (verticalProgress) {
        gsap.to(verticalProgress, {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '.lg\\:hidden',
            start: 'top 70%',
            end: 'bottom 60%',
            scrub: true,
          }
        });
      }

      // 3. Pinned Horizontal Card Scroll for Desktop - Pin Outermost Section
      if (track) {
        const amount = track.scrollWidth - window.innerWidth;
        
        gsap.to(track, {
          x: () => -amount - 80, // translate track to show cards
          ease: 'none',
          scrollTrigger: {
            trigger: section, // Pin the outer #journey section
            pin: true,
            start: 'top 72px', // Pin exactly when top of #journey meets the bottom of navbar
            end: () => `+=${amount + 120}`, // Scroll amount matches translation distance
            scrub: 1,
            invalidateOnRefresh: true, // handle resize events
          }
        });
      }
    }
  });
</script>
