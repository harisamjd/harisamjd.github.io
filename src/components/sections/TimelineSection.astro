---
import { careerTimeline } from '../../content/data/personal';
import { Calendar } from '@lucide/astro';
---

<section
  id="journey"
  class="py-[120px] bg-bg px-6 overflow-hidden transition-opacity opacity-0 transform translate-y-[40px] entry-section"
  aria-labelledby="journey-heading"
>
  <div class="max-w-[1100px] mx-auto relative">
    <!-- Header -->
    <div class="mb-16">
      <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
        My Evolution
      </span>
      <h2 id="journey-heading" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4">
        From Manufacturing to Digital Transformation
      </h2>
      <p class="text-body text-text-secondary max-w-[640px]">
        Every stage of my career has taught me a different way to solve problems. Instead of changing industries, I have continuously expanded the way I create value.
      </p>
    </div>

    <!-- Mobile Vertical Timeline (hidden on lg) -->
    <div class="relative flex flex-col lg:hidden pl-8 gap-12">
      <!-- Progress Track Line -->
      <div class="absolute left-[11px] top-2 bottom-2 w-[2px] bg-divider"></div>
      <!-- Animated Progress Fill Line -->
      <div
        id="timeline-progress-vertical"
        class="absolute left-[11px] top-2 w-[2px] bg-accent origin-top scale-y-0"
      ></div>

      {careerTimeline.map((item, index) => {
        const isLast = index === careerTimeline.length - 1;
        return (
          <div class="relative timeline-node-mobile flex flex-col gap-2">
            <!-- Bullet Point Indicator -->
            <div class={`absolute -left-[27px] top-1.5 w-4 h-4 rounded-full border-2 bg-white transition-all duration-500 timeline-bullet ${isLast ? 'border-accent scale-125' : 'border-divider'}`}>
              {isLast && <div class="w-1.5 h-1.5 bg-accent rounded-full m-auto mt-[3px]"></div>}
            </div>

            <!-- Content Card -->
            <div class="flex items-center gap-2 text-caption text-text-muted font-medium">
              <Calendar class="w-3.5 h-3.5" />
              <span>{item.period}</span>
            </div>
            <h3 class={`text-heading-sm font-semibold ${isLast ? 'text-accent' : 'text-text-primary'}`}>
              {item.role}
            </h3>
            <span class="text-body-sm font-medium text-text-secondary">
              {item.company}
            </span>
            <p class="text-body-sm text-text-muted mt-1 max-w-[480px]">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>

    <!-- Desktop Horizontal Timeline (hidden on <lg) -->
    <div class="hidden lg:flex flex-col relative pt-12 pb-6">
      <!-- Progress Track Line -->
      <div class="absolute left-0 right-0 top-[60px] h-[2px] bg-divider z-0"></div>
      <!-- Animated Progress Fill Line -->
      <div
        id="timeline-progress-horizontal"
        class="absolute left-0 top-[60px] h-[2px] bg-accent z-0 origin-left scale-x-0 w-full"
      ></div>

      <!-- Timeline Items Row -->
      <div class="grid grid-cols-5 gap-6 relative z-10">
        {careerTimeline.map((item, index) => {
          const isLast = index === careerTimeline.length - 1;
          return (
            <div class="flex flex-col timeline-node-desktop">
              <!-- Bullet Point Connector -->
              <div class="flex items-center justify-center mb-8 relative">
                <div class={`w-4 h-4 rounded-full border-2 bg-white transition-all duration-500 timeline-bullet ${isLast ? 'border-accent scale-125' : 'border-divider'}`}>
                  {isLast && <div class="w-1.5 h-1.5 bg-accent rounded-full m-auto mt-[3px]"></div>}
                </div>
              </div>

              <!-- Content details -->
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 text-caption text-text-muted font-medium">
                  <Calendar class="w-3.5 h-3.5" />
                  <span>{item.period}</span>
                </div>
                <h3 class={`text-body font-semibold leading-tight ${isLast ? 'text-accent' : 'text-text-primary'}`}>
                  {item.role}
                </h3>
                <span class="text-caption font-medium text-text-secondary">
                  {item.company}
                </span>
                <p class="text-caption text-text-muted mt-2 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('journey');
    const verticalProgress = document.getElementById('timeline-progress-vertical');
    const horizontalProgress = document.getElementById('timeline-progress-horizontal');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(section, { opacity: 1, y: 0 });
      gsap.set([verticalProgress, horizontalProgress], { scaleX: 1, scaleY: 1 });
      document.querySelectorAll('.timeline-bullet').forEach(bullet => {
        bullet.classList.add('border-accent');
      });
    } else {
      // 1. Entrance Reveal for Section
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      });

      // 2. Animate Mobile Vertical Timeline Progress Line
      if (verticalProgress) {
        gsap.to(verticalProgress, {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '.lg\\:hidden', // Targets the mobile wrapper
            start: 'top 70%',
            end: 'bottom 60%',
            scrub: true,
          }
        });
      }

      // 3. Animate Desktop Horizontal Timeline Progress Line
      if (horizontalProgress) {
        gsap.to(horizontalProgress, {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '.hidden.lg\\:flex', // Targets the desktop wrapper
            start: 'top 70%',
            end: 'bottom 65%',
            scrub: true,
          }
        });
      }

      // 4. Highlight Bullets sequentially based on scroll trigger
      const bullets = document.querySelectorAll('.timeline-bullet');
      bullets.forEach((bullet) => {
        gsap.to(bullet, {
          borderColor: '#2563eb', // Accent color
          scrollTrigger: {
            trigger: bullet,
            start: 'top 75%',
            toggleActions: 'play none none reverse',
          }
        });
      });
    }
  });
</script>
