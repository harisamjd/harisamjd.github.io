---
import { ArrowDown } from '@lucide/astro';
import { personalInfo } from '../../content/data/personal';
import { getImage } from 'astro:assets';
// Import FAZZA-3339.jpg for the background image
import heroBgImage from '../../assets/picts/FAZZA-3339.jpg';

// Optimize the background image using Astro's image service
const optimizedHeroBg = await getImage({ src: heroBgImage, format: 'webp', width: 1920, quality: 80 });
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center items-center px-6 overflow-hidden bg-cover bg-center bg-no-repeat"
  style={`background-image: url(${optimizedHeroBg.src});`}
  aria-label="Welcome and Introduction"
>
  <!-- Dark vignette overlays to ensure perfect contrast and text readability -->
  <div class="absolute inset-0 bg-bg/75 backdrop-blur-[2px] z-0"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-bg/90 via-transparent to-bg z-0"></div>

  <!-- Grid Mesh Ornament -->
  <div class="absolute inset-0 bg-grid-mesh opacity-15 pointer-events-none select-none z-0"></div>

  <!-- Decorative R&D Process Flowchart Blueprint SVG -->
  <div class="absolute right-10 top-1/2 -translate-y-1/2 w-[540px] h-[540px] hidden lg:block opacity-[0.25] z-0 select-none pointer-events-none">
    <svg viewBox="0 0 100 100" class="w-full h-full text-text-primary stroke-current fill-none stroke-[0.2]" id="blueprint-svg">
      <!-- Grid coordinates indicator -->
      <text x="2" y="5" class="text-[2px] fill-text-secondary stroke-none font-mono">SYS_COORD: [45.18.99]</text>
      <text x="2" y="8" class="text-[2px] fill-text-secondary stroke-none font-mono">OP_MODE: SSG_PASSIVE</text>

      <!-- Flowchart connector path -->
      <path d="M 10 20 L 35 20 L 35 45 L 60 45" class="stroke-divider" stroke-dasharray="1 1"></path>
      
      <!-- Input Node -->
      <circle cx="10" cy="20" r="3" class="fill-bg stroke-accent stroke-[0.4]"></circle>
      <text x="10" y="21" class="text-[2.5px] fill-accent stroke-none font-mono text-center font-bold" text-anchor="middle">R&D</text>
      
      <!-- Processing Step -->
      <rect x="25" y="15" width="20" height="10" rx="1.5" class="fill-bg stroke-text-primary stroke-[0.3]"></rect>
      <text x="35" y="20" class="text-[2px] fill-text-primary stroke-none font-mono text-center" text-anchor="middle">TRIAL INPUT</text>
      <text x="35" y="23" class="text-[1.5px] fill-text-secondary stroke-none font-mono text-center" text-anchor="middle">PARAM_SET_A</text>
      
      <!-- Vertical Flow line -->
      <line x1="35" y1="25" x2="35" y2="40" class="stroke-text-primary"></line>
      <polygon points="33.5,37 35,40 36.5,37" class="fill-text-primary"></polygon>

      <!-- Decision Diamond -->
      <polygon points="35,40 43,45 35,50 27,45" class="fill-bg stroke-secondary-accent stroke-[0.4]"></polygon>
      <text x="35" y="46" class="text-[1.5px] fill-text-primary stroke-none font-mono text-center" text-anchor="middle">WASTE &lt; 15%</text>

      <!-- Yes branch -->
      <line x1="43" y1="45" x2="57" y2="45" class="stroke-secondary-accent"></line>
      <text x="49" y="43" class="text-[1.8px] fill-secondary-accent stroke-none font-mono">YES</text>
      <rect x="57" y="40" width="20" height="10" rx="1.5" class="fill-bg stroke-secondary-accent stroke-[0.3]"></rect>
      <text x="67" y="45" class="text-[2px] fill-secondary-accent stroke-none font-mono text-center" text-anchor="middle">COMMERCIAL SCALE</text>
      
      <!-- No branch / loop back -->
      <line x1="27" y1="45" x2="15" y2="45" class="stroke-accent"></line>
      <text x="21" y="43" class="text-[1.8px] fill-accent stroke-none font-mono">NO</text>
      <line x1="15" y1="45" x2="15" y2="23" class="stroke-accent"></line>
      <polygon points="13.5,25 15,22 16.5,25" class="fill-accent"></polygon>
      
      <!-- Data Visualization Analytics Graph -->
      <rect x="10" y="65" width="30" height="20" rx="1.5" class="fill-bg/80 stroke-divider stroke-[0.3]"></rect>
      <path d="M 12 80 L 38 80 M 14 80 L 14 67" class="stroke-text-secondary stroke-[0.2]"></path>
      <!-- Bars -->
      <rect x="16" y="74" width="3" height="6" class="fill-accent/30 stroke-accent stroke-[0.2]"></rect>
      <rect x="21" y="70" width="3" height="10" class="fill-accent/30 stroke-accent stroke-[0.2]"></rect>
      <rect x="26" y="76" width="3" height="4" class="fill-accent/30 stroke-accent stroke-[0.2]"></rect>
      <rect x="31" y="72" width="3" height="8" class="fill-secondary-accent/40 stroke-secondary-accent stroke-[0.2]"></rect>
      <text x="25" y="62" class="text-[2px] fill-text-secondary stroke-none font-mono">BI REPORTING / KPI</text>

      <!-- Connection Nodes dots -->
      <circle cx="67" cy="40" r="0.5" class="fill-text-secondary"></circle>
      <path d="M 67 40 L 67 30 L 80 30" class="stroke-divider stroke-[0.2]" stroke-dasharray="1 1"></path>
      <circle cx="80" cy="30" r="1" class="fill-accent"></circle>
      <text x="83" y="31" class="text-[2px] fill-text-secondary stroke-none font-mono">AUTOMATED_FLOW</text>
    </svg>
  </div>

  <!-- Main Hero Content -->
  <div class="max-w-[900px] w-full text-center flex flex-col items-center select-none pt-12 relative z-10">
    <!-- Intro greeting -->
    <span
      id="hero-greeting"
      class="text-accent text-body-sm font-semibold tracking-wider uppercase mb-4 opacity-0 transform translate-y-[20px]"
    >
      Hi, I'm {personalInfo.fullName}
    </span>

    <!-- Name / Main Headline with Typewriter Container -->
    <h1
      id="hero-headline"
      class="text-display-lg md:text-display-xl font-bold tracking-tight text-text-primary leading-none mb-6 opacity-0 transform translate-y-[40px] flex items-center justify-center gap-1.5"
    >
      <span id="hero-typing-target"></span><span id="hero-typing-cursor" class="text-accent animate-pulse font-light select-none font-mono">|</span>
    </h1>

    <!-- Titles & Positioning -->
    <p
      id="hero-subtitle"
      class="text-body-lg text-text-secondary max-w-[680px] leading-relaxed mb-10 opacity-0 transform translate-y-[40px]"
    >
      I transform complex business challenges and operational data into practical and data-driven digital solutions that improve efficiency, enable better decisions, and create measurable business impact.
    </p>

    <!-- Scroll Down Indicator (Standalone trigger below tagline) -->
    <div
      id="hero-scroll"
      class="mt-8 flex flex-col items-center gap-1.5 opacity-0 transform translate-y-[15px] cursor-pointer group/scroll"
    >
      <span class="text-[10px] font-mono text-accent font-semibold tracking-widest uppercase group-hover/scroll:text-white transition-colors">
        Click or Scroll to Follow My Journey
      </span>
      <ArrowDown class="w-4 h-4 text-accent animate-scroll-sweep" />
    </div>
  </div>
</section>

<style>
  @keyframes scroll-sweep {
    0% {
      transform: translateY(-5px);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    80% {
      transform: translateY(5px);
      opacity: 0;
    }
    100% {
      transform: translateY(5px);
      opacity: 0;
    }
  }

  .animate-scroll-sweep {
    animation: scroll-sweep 1.8s infinite ease-in-out;
  }
</style>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const greeting = document.getElementById('hero-greeting');
    const headline = document.getElementById('hero-headline');
    const subtitle = document.getElementById('hero-subtitle');
    const scrollIndicator = document.getElementById('hero-scroll');
    const blueprintSvg = document.getElementById('blueprint-svg');
    
    // Typewriter targets
    const typingTarget = document.getElementById('hero-typing-target');
    const typingCursor = document.getElementById('hero-typing-cursor');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Typewriter configuration
    const fullText = "Engineering Processes, Empowering Data, Digitalizing Solutions";
    let charIdx = 0;

    const runTypewriter = () => {
      if (!typingTarget) return;
      if (charIdx < fullText.length) {
        typingTarget.textContent += fullText.charAt(charIdx);
        charIdx++;
        setTimeout(runTypewriter, 70); // 70ms per character typing speed
      } else {
        // Remove blinking cursor or let it pulse
        if (typingCursor) {
          gsap.to(typingCursor, { opacity: 0, delay: 1.5, duration: 0.5, onComplete: () => typingCursor.remove() });
        }
      }
    };

    const triggerHeroTimeline = () => {
      if (prefersReducedMotion) {
        if (typingTarget) typingTarget.textContent = fullText;
        if (typingCursor) typingCursor.remove();
        gsap.set([greeting, headline, subtitle, scrollIndicator], { opacity: 1, y: 0 });
        if (blueprintSvg) gsap.set(blueprintSvg, { opacity: 0.25 });
        return;
      }

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.to(greeting, { opacity: 1, y: 0, duration: 0.6 })
        .to(headline, { 
          opacity: 1, 
          y: 0, 
          duration: 0.8,
          onStart: () => {
            runTypewriter(); // Start typing animation when headline enters
          }
        }, '-=0.4')
        .to(subtitle, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
        .to(scrollIndicator, { opacity: 1, y: 0, duration: 0.6 }, '-=0.4');

      if (blueprintSvg) {
        gsap.fromTo(blueprintSvg, 
          { opacity: 0, x: 20 },
          { opacity: 0.25, x: 0, duration: 1.5, ease: 'power2.out', delay: 0.5 }
        );
      }
    };

    // Attach click handler to scroll indicator to navigate smoothly
    scrollIndicator?.addEventListener('click', () => {
      const aboutSection = document.getElementById('about');
      aboutSection?.scrollIntoView({ behavior: 'smooth' });
    });

    // Synchronize starting the hero timeline after the intro curtain has completely slid up
    window.addEventListener('intro-complete', triggerHeroTimeline);

    // Listen for presentation start to reset and re-trigger typewriter
    window.addEventListener('presentation-start', () => {
      charIdx = 0;
      if (typingTarget) {
        typingTarget.textContent = "";
      }
      
      // Re-create typing cursor if it was removed
      let cursor = document.getElementById('hero-typing-cursor');
      if (!cursor && headline) {
        cursor = document.createElement('span');
        cursor.id = 'hero-typing-cursor';
        cursor.className = 'text-accent animate-pulse font-light select-none font-mono';
        cursor.textContent = '|';
        headline.appendChild(cursor);
      }
      
      // Re-trigger typewriter animation
      runTypewriter();
    });
  });
</script>
