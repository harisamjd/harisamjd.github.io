---
import { ArrowRight } from '@lucide/astro';
---

<section
  id="contact"
  class="py-[120px] bg-bg px-6 transition-opacity opacity-0 transform translate-y-[40px]"
  aria-labelledby="contact-heading"
>
  <div class="max-w-[1100px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Info Left Column -->
      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
            Get in Touch
          </span>
          <h2 id="contact-heading" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4">
            Let's Build Something Meaningful
          </h2>
          <p class="text-body text-text-secondary leading-relaxed max-w-[480px]">
            Whether you're looking for someone to improve business processes, develop digital solutions, or drive operational transformation, I'd love to hear from you.
          </p>
        </div>

        <div class="hidden lg:block mt-12 border-t border-divider pt-6">
          <p class="text-caption text-text-muted">
            Located in Indonesia &bull; Supporting global collaborations
          </p>
        </div>
      </div>

      <!-- Links Right Column -->
      <div class="lg:col-span-6 flex flex-col justify-center gap-6">
        <h3 class="text-body-sm font-semibold tracking-wider text-text-primary uppercase mb-2">
          Direct Channels
        </h3>
        
        <div class="flex flex-col gap-4">
          <!-- LinkedIn Link Row -->
          <a
            href="https://www.linkedin.com/in/harisam"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-6 bg-surface border border-divider rounded-md hover:border-accent/35 hover:shadow-sm transition-all duration-300 group"
          >
            <div>
              <span class="text-caption text-text-muted block">Professional Network</span>
              <span class="text-body font-semibold text-text-primary group-hover:text-accent transition-colors duration-300">
                Connect on LinkedIn
              </span>
            </div>
            <ArrowRight class="w-5 h-5 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-300" />
          </a>

          <!-- Email Link Row -->
          <a
            href="mailto:harisamjd@gmail.com"
            class="flex items-center justify-between p-6 bg-surface border border-divider rounded-md hover:border-accent/35 hover:shadow-sm transition-all duration-300 group"
          >
            <div>
              <span class="text-caption text-text-muted block">Direct Inquiry</span>
              <span class="text-body font-semibold text-text-primary group-hover:text-accent transition-colors duration-300">
                Send an Email
              </span>
            </div>
            <ArrowRight class="w-5 h-5 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-300" />
          </a>

          <!-- WhatsApp Link Row -->
          <a
            href="https://wa.me/628567890858"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-6 bg-surface border border-divider rounded-md hover:border-accent/35 hover:shadow-sm transition-all duration-300 group"
          >
            <div>
              <span class="text-caption text-text-muted block">Instant Messaging</span>
              <span class="text-body font-semibold text-text-primary group-hover:text-accent transition-colors duration-300">
                Chat on WhatsApp
              </span>
            </div>
            <ArrowRight class="w-5 h-5 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-300" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('contact');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(section, { opacity: 1, y: 0 });
    } else {
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          toggleActions: 'play none none none',
        }
      });
    }
  });
</script>
