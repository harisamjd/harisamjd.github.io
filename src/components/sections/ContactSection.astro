---
// Centered Minimal Contact Section
---

<section
  id="contact"
  class="py-[120px] bg-bg px-6 transition-opacity opacity-0 transform translate-y-[40px]"
  aria-labelledby="contact-heading"
>
  <div class="max-w-[800px] mx-auto text-center">
    <span class="text-caption text-text-muted tracking-widest uppercase font-semibold block mb-2">
      Get in Touch
    </span>
    <h2 id="contact-heading" class="text-heading-xl text-text-primary font-bold tracking-tight mb-4">
      Let's Build Something Meaningful
    </h2>
    <p class="text-body text-text-secondary leading-relaxed max-w-[580px] mx-auto mb-8">
      Whether you're looking for someone to improve business processes, develop digital solutions, or drive operational transformation, I'd love to hear from you.
    </p>
    
    <div class="border-t border-divider pt-6 inline-block">
      <p class="text-caption text-text-muted">
        Based in Bogor / Solo, Indonesia &bull; Supporting Global Collaborations
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('contact');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(section, { opacity: 1, y: 0 });
    } else {
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          toggleActions: 'play none none none',
        }
      });
    }
  });
</script>
